# ============================================================================
# 智能流量安全检测与分析系统 —— 环境变量模板
# 用法：cp .env.example .env 后按需修改；容器部署直接映射到 docker-compose 的 environment
# 说明：所有 *_PORTS / *_CIDRS / *_CHANNELS / *_RECIPIENTS / *_TARGETS 均为逗号分隔字符串
# ============================================================================

# ---------- 基础 ----------
DEBUG=false
API_TOKEN=                      # 留空=内网免认证；一旦配置，写接口必须携带 X-API-Token
CORS_ORIGINS=*
DASHBOARD_DIR=                  # 留空自动定位到仓库 dashboard 目录

# ---------- 存储 ----------
DB_URL=sqlite:///./data/secops.db            # 单机轻量部署；生产建议 postgresql+psycopg2://secops:secops@db:5432/secops
INFLUX_URL=                                   # 如 http://tsdb:8086，留空则不写时序库
INFLUX_TOKEN=
INFLUX_ORG=secops
INFLUX_BUCKET=traffic

# ---------- 采集 ----------
CAPTURE_MODE=auto               # auto|ebpf|scapy|demo（auto：eBPF → libpcap → 仿真）
CAPTURE_IFACE=                  # 如 eth0，留空自动挑选
BPF_FILTER=ip and (tcp or udp)
TICK_INTERVAL_MS=500            # 聚合/推送周期（毫秒）
LINK_SPEED_MBPS=1000            # 网卡标称带宽，用于计算带宽利用率
TREND_POINTS=600                # 趋势图保留点数（内存环形缓冲长度）
CONN_IDLE_TIMEOUT_SEC=120

# ---------- 检测参数 ----------
ZSCORE_THRESHOLD=3.5            # 稳健 Z-score 告警阈值
ANOMALY_WARMUP_TICKS=20         # 基线预热 tick 数（避免冷启动误报）
PORT_SCAN_UNIQUE_PORTS=60       # 单源目的端口多样性阈值
PORT_SCAN_WINDOW_SEC=10
BRUTE_FORCE_ATTEMPTS=40         # 单源对认证端口的访问次数阈值
SPIKE_MIN_ABS_BPS=104857600    # 突发告警基线（默认 100Mbps）：低于该值不判突发
SPIKE_BPS_THRESHOLD=209715200  # 突发硬阈值/直达线（默认 200Mbps）：达到即 critical 并自动封禁
SPIKE_DETECT_ENABLED=true      # 整机流量突发检测总开关
IFOREST_ENABLED=true
IFOREST_CONTAMINATION=0.05
DETECT_IGNORE_IPS=              # 流量检测忽略的源 IP/CIDR（如授权扫描器、本机回环），防自扫描误报
STANDARD_PORTS=20,21,22,23,25,53,67,68,80,110,123,143,161,389,443,465,514,587,636,993,995,1080,1433,1521,2049,3306,3389,5432,5900,6379,8000,8080,8443,9000,9200,27017
BRUTE_FORCE_PORTS=21,22,23,135,139,445,1433,1521,3306,3389,5432,5900,6379,11211,27017

# ---------- 响应（自动封禁） ----------
AUTO_BLOCK_ENABLED=true
AUTO_BLOCK_MIN_SEVERITY=high    # critical|high|medium|low
BLOCK_TTL_SEC=1800              # 自动封禁存活时间，到期自动解封
FIREWALL_BACKEND=auto           # auto|iptables|nftables|firewalld|none
DRY_RUN=true                    # ★ 安全默认：只记录不真正下发规则，验证无误后改为 false
FIREWALL_CHAIN=INPUT
WHITELIST_CIDRS=127.0.0.1/32,::1/128,169.254.0.0/16,224.0.0.0/4

# ---------- 告警通道 ----------
ALERT_CHANNELS=log              # log|webhook|email|syslog，可多选
DINGTALK_WEBHOOK=               # 钉钉机器人：https://oapi.dingtalk.com/robot/send?access_token=xxx
WECOM_WEBHOOK=                  # 企业微信机器人：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
GENERIC_WEBHOOK=                # 通用 JSON 回调（对接自研 SOC/工单系统）
SYSLOG_ADDRESS=                 # 如 siem.internal:514
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_RECIPIENTS=
ALERT_COOLDOWN_SEC=60           # 同一 (类型, 源IP) 的告警抑制窗口（评分冷却期复用该项，不新增配置）

# ---------- 统一规则层（内置知识库 + 开源规则库） ----------
RULES_DIR=                      # 留空使用 backend/data（含 sigma_rules/ 与 et_rules/ 子目录）
SIGMA_RULES_ENABLED=true        # 是否加载 data/sigma_rules/*.yml（需 pyyaml）
ET_RULES_ENABLED=true           # 是否加载 data/et_rules/*.rules（Suricata/ET Open）
CVE_EXT_ENABLED=true            # 是否加载 data/cve_rules_extended.json 并与内置 CVE 合并
RULE_RELOAD_INTERVAL_SEC=300    # 规则热加载周期（0=关闭定时热加载，仍可用 POST /rules/reload）

# ---------- 告警聚合评分（滑动窗口 + 直达机制） ----------
ALERT_SCORE_THRESHOLD=6.0       # 聚合风险分阈值（只影响告警，不改变自动封禁门槛）
SCORING_WINDOW_SEC=300          # 评分滑动窗口（秒）
SCORING_MAX_SIGNALS_PER_WINDOW=1000
MULTI_CATEGORY_BONUS_2=1.2      # 命中 ≥2 个攻击大类时的加成
MULTI_CATEGORY_BONUS_3=1.5      # 命中 ≥3 个攻击大类时的加成
CRITICAL_BONUS=1.3              # 窗口内存在 critical 信号时的加成
DIRECT_ALERT_ENABLED=true       # 直达机制：单条致命规则命中立即告警（绕过聚合投票）
DIRECT_ALERT_WEIGHT=6.0         # 单信号权重直达阈值（6.0 = critical 5.0 × high 1.2）

# ---------- 自适应阈值（误报/真阳反馈驱动） ----------
ADAPTIVE_THRESHOLD_ENABLED=true
ADAPTIVE_AUTO_RECOMPUTE=true    # 是否后台定时重算
THRESHOLD_RECOMPUTE_INTERVAL_SEC=21600   # 重算周期（秒，默认 6 小时）
THRESHOLD_LOOKBACK_DAYS=14      # 重算回看天数
THRESHOLD_FP_HIGH=0.5           # 误报率高于该值 → 阈值收紧
THRESHOLD_FP_LOW=0.1            # 误报率低于该值 → 阈值放松
THRESHOLD_TIGHTEN_FACTOR=1.3
THRESHOLD_LOOSEN_FACTOR=0.9
THRESHOLD_MIN_FACTOR=0.5        # 相对静态基准的下限倍数
THRESHOLD_MAX_FACTOR=2.0        # 相对静态基准的上限倍数

# ---------- AI 研判（DeepSeek / 任意 OpenAI 兼容接口）+ 降级链 ----------
LLM_ENABLED=true                # 关闭或未配置 KEY 时自动降级到本地规则/模板（不阻塞告警）
LLM_API_KEY=                    # 如 sk-xxxx；留空 = 直接走降级链
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SEC=3.0             # 单次研判超时（必须远小于告警节奏）
LLM_MAX_RETRIES=1
LLM_CACHE_TTL_SEC=3600          # 同源同类研判结果缓存时长（0=不缓存）
LLM_MASK_INTERNAL_IP=true       # 发送前内网 IP 脱敏（只发结构化摘要，不发原始 payload/URL）
LLM_WORKER_THREADS=1            # 异步研判工作线程数
LLM_QUEUE_SIZE=200              # 研判队列上限（满则丢弃并保持"待人工"）

# ---------- 扫描与 CVE ----------
SCANNER_ENABLED=true
NMAP_PATH=nmap
SCAN_TIMEOUT_SEC=300
SCAN_TARGETS=                   # 如 192.168.1.0/24；留空则扫描已发现的资产
CVE_RULES_FILE=                 # 留空使用 backend/data/cve_rules.json

# ---------- Web 攻击检测（HTTP 侧，知识库 backend/data/web_attack_rules.json） ----------
WEB_DETECT_ENABLED=true         # 是否启用 Web 攻击检测（命中即产生 web_* 告警可自动封禁）
WEB_DETECT_SOURCE=auto          # auto|log|demo|api|off
                                #   auto：配置了 WEB_LOG_PATH 就 tail 日志，否则用仿真请求（演示）
                                #   log ：tail nginx/Apache combined 访问日志（零侵入，但看不到请求体）
                                #   api ：仅等待 WAF/代理通过 POST /web/requests 投递
WEB_LOG_PATH=                   # 如 /var/log/nginx/access.log（log/auto 模式使用）
WEB_LOG_POLL_SEC=1              # 访问日志轮询间隔（秒）
WEB_DEMO_INTERVAL_SEC=2.5       # 仿真请求间隔（秒，demo 模式）
WEB_DETECT_BATCH=200            # 每个采集 tick 最多检测的请求条数
WEB_QUEUE_SIZE=2000             # 请求队列上限（超出丢弃最旧，防止内存膨胀）
WEB_BRUTE_FORCE_ATTEMPTS=10     # 登录接口暴力破解判定次数（覆盖知识库阈值）
WEB_ATTACK_RULES_FILE=          # 留空使用 backend/data/web_attack_rules.json

# ---------- 通用 Web 检测 / 漏扫 ----------
WEB_STRICT_RULES_FILE=          # 高置信直达规则文件，留空使用 backend/data/web_strict_rules.json
WEB_IGNORE_IPS=                 # Web 检测忽略的源 IP/CIDR（管理机、扫描器），防自访问误报
WEB_DEFAULT_DST_IP=             # 访问日志缺少目的地址时的默认业务地址
WEB_DEFAULT_DST_PORT=8080       # 访问日志缺少目的端口时的默认值
WEB_AUTO_BLOCK_REQUIRES_DIRECT=true  # Web 告警自动封禁需直达规则确认（防误封）
WEBAPP_SCAN_ENABLED=true        # 漏扫时探测 Web 应用（通用指纹 + 配置缺陷 + 暴露面）
WEBAPP_SCAN_TIMEOUT_SEC=3.0     # 单个 Web 探测请求超时（秒）
WEBAPP_SCAN_MAX_PAGES=24        # 单次漏扫最多访问页面数（只跟同主机链接）
WEBAPP_SCAN_MAX_SECONDS=20      # 单次漏扫总耗时上限（秒）
WEBAPP_SCAN_USERNAME=           # 需要登录时用于漏扫的账号（留空只扫匿名可见面）
WEBAPP_SCAN_PASSWORD=           # 需要登录时用于漏扫的口令（无任何内置默认值）

# ---------- 攻击流量 → 漏洞研判（主动漏扫看不到注入点，靠这一层补） ----------
WEB_VULN_INFER_ENABLED=true     # 捕获到 Web 攻击时，用「请求 + 响应」研判该服务存在什么漏洞
WEB_VULN_INFER_AI=true          # 研判时是否调用 LLM 复核（未配置 KEY 时只用响应特征规则）
WEB_VULN_INFER_LIMIT=200        # 单次研判回看的 Web 攻击事件条数（10~2000）


# ---------- 登录 / 会话 / 审计（v6 P0） ----------
AUTH_ENABLED=true               # 本地演示可临时设 false（仅限内网，风险见文档）
ADMIN_INITIAL_PASSWORD=         # 留空=首次启动生成随机密码并打印到启动日志；此处不要填固定弱口令
SESSION_TTL_SEC=43200
SESSION_IDLE_SEC=1800
LOGIN_MAX_FAILS=10
LOGIN_LOCK_SEC=900
PASSWORD_MIN_LEN=10
COOKIE_SECURE=false             # HTTPS 部署改 true

# ---------- 威胁事件 / 报告（v6 P1） ----------
THREAT_STORE_ENABLED=true
THREAT_RETENTION_DAYS=7
THREAT_REQUEST_MAX_BYTES=16384
THREAT_RESPONSE_MAX_BYTES=8192
THREAT_MASK_SECRETS=true
THREAT_RATE_LIMIT_PER_MIN=6000  # 每分钟最多落库的威胁事件数（0=不限）
THREAT_EXPORT_MAX_ROWS=100000
REPORT_DIR=
REPORT_MAX_EVENTS=200

# ---------- 规则包 / 分层 / 匹配引擎（v6 P2） ----------
RULESETS_ENABLED=true
RULESETS_DIR=
RULES_TIERS=core
RULES_SHADOW_MODE=false
RULES_MAX_COUNT=10000
RULES_UNKNOWN_CATEGORY=reject
MATCH_BACKEND=auto
RE2_MAX_MEM_MB=64
TRIAGE_ENABLED=false
FLOW_RULES_ENABLED=false        # 占位：流级执行器尚未实现，当前版本改了也不生效
MALWARE_SCAN_ENABLED=false
PROTECTED_CIDRS=                # 例如 192.168.1.0/24；留空=方向 unknown

