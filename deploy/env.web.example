# ============================================================================
# 单机 Web 业务场景（Apache 8080）推荐配置
#
# 适用：被测 Web 服务与本系统同机部署（如 Apache/Nginx + PHP/Java 业务站点）。
# 系统按通用能力做流量检测与 Web 漏扫，不假设业务是任何特定产品。
#
# 用法（在仓库根目录）：
#   cp deploy/env.web.example .env
#   vi .env    # 至少修改 CAPTURE_IFACE / WHITELIST_CIDRS / LLM_API_KEY
#   sudo bash deploy/install.sh --web-profile
#   sudo bash deploy/install.sh --web-profile --http-proxy   # 高保真：8080 代理 → 业务 8081（含 POST body）
# ============================================================================

# ---------- 基础 ----------
DEBUG=false
API_TOKEN=
# 留空时 install.sh 在 AUTH_ENABLED=true 下会自动生成随机 Token（代理/脚本用）。
CORS_ORIGINS=*
DASHBOARD_DIR=

# ---------- 存储 ----------
DB_URL=sqlite:///./data/secops.db
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=secops
INFLUX_BUCKET=traffic

# ---------- 采集 ----------
# VMware NAT 默认网卡通常是 ens33；用 `ip -br a` 确认后填写。
CAPTURE_MODE=auto
CAPTURE_IFACE=ens33
BPF_FILTER=ip and (tcp or udp)
TICK_INTERVAL_MS=500
LINK_SPEED_MBPS=1000
TREND_POINTS=600
CONN_IDLE_TIMEOUT_SEC=120

# ---------- 检测参数 ----------
ZSCORE_THRESHOLD=3.5
ANOMALY_WARMUP_TICKS=20
PORT_SCAN_UNIQUE_PORTS=60
PORT_SCAN_WINDOW_SEC=10
BRUTE_FORCE_ATTEMPTS=40
# 突发告警：100Mbps 起报，200Mbps 直达 critical（100~200M 按 Z 给中/高危，走聚合）。
SPIKE_BPS_THRESHOLD=209715200
# 突发流量统计检测总开关：靶场/实验环境建议 false（VM 里一次 apt/pip 下载就会超过低基线，
# 产生「整机流量 1.2Mbps 超出基线 80Kbps」这类噪声告警）。关闭后端口扫描/爆破/Web 检测不受影响。
SPIKE_DETECT_ENABLED=false
# 告警基线（绝对下限，bps）。低于该值即使 Z 超阈也不告警。
# 当前 100Mbps = 104857600；按业务实际峰值带宽设置。
SPIKE_MIN_ABS_BPS=104857600
# 靶场场景关闭无监督离群告警（IForest 固有 ~5% 离群率，容易产生“误报”观感；
# 需要时改 true，并仅作 medium 级人工复核，不参与自动封禁）。
IFOREST_ENABLED=false
IFOREST_CONTAMINATION=0.05
# 忽略本机/授权扫描器产生的流量，避免我们自己扫 127.0.0.1 时触发端口扫描告警。
DETECT_IGNORE_IPS=127.0.0.1,::1
STANDARD_PORTS=20,21,22,23,25,53,67,68,80,110,123,143,161,389,443,465,514,587,636,993,995,1080,1433,1521,2049,3306,3389,5432,5900,6379,8000,8080,8443,9000,9200,27017
BRUTE_FORCE_PORTS=21,22,23,135,139,445,1433,1521,3306,3389,5432,5900,6379,11211,27017

# ---------- 响应（自动封禁） ----------
AUTO_BLOCK_ENABLED=true
AUTO_BLOCK_MIN_SEVERITY=high
BLOCK_TTL_SEC=1800
FIREWALL_BACKEND=auto
# ★ 首次部署保持 true（只记录不落规则）；完成下面「验收清单」后再改 false。
DRY_RUN=true
FIREWALL_CHAIN=INPUT
# 只保留系统必留地址：回环、链路本地、组播。
# ⚠ 不要把 10/8、172.16/12、192.168/16 整段加进来——VMware NAT 下宿主机攻击流量
#   的源地址就是 VMnet8 网关（192.168.x.1），一旦白名单覆盖它，封禁会被直接拒绝。
#   若担心把自己关在门外，改用 BLOCK_TTL_SEC 短 TTL + 控制台手动解封，而不是整段白名单。
WHITELIST_CIDRS=127.0.0.1/32,::1/128,169.254.0.0/16,224.0.0.0/4

# ---------- 告警通道 ----------
ALERT_CHANNELS=log
ALERT_COOLDOWN_SEC=60
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=
GENERIC_WEBHOOK=
SYSLOG_ADDRESS=
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_RECIPIENTS=

# ---------- 统一规则层 ----------
RULES_DIR=
SIGMA_RULES_ENABLED=true
ET_RULES_ENABLED=true
CVE_EXT_ENABLED=true
RULE_RELOAD_INTERVAL_SEC=300

# ---------- 告警聚合评分 / 直达机制 ----------
ALERT_SCORE_THRESHOLD=6.0
SCORING_WINDOW_SEC=300
SCORING_MAX_SIGNALS_PER_WINDOW=1000
MULTI_CATEGORY_BONUS_2=1.2
MULTI_CATEGORY_BONUS_3=1.5
CRITICAL_BONUS=1.3
DIRECT_ALERT_ENABLED=true
DIRECT_ALERT_WEIGHT=6.0

# ---------- 自适应阈值 ----------
ADAPTIVE_THRESHOLD_ENABLED=true
ADAPTIVE_AUTO_RECOMPUTE=true
THRESHOLD_RECOMPUTE_INTERVAL_SEC=21600
THRESHOLD_LOOKBACK_DAYS=14
THRESHOLD_FP_HIGH=0.5
THRESHOLD_FP_LOW=0.1
THRESHOLD_TIGHTEN_FACTOR=1.3
THRESHOLD_LOOSEN_FACTOR=0.9
THRESHOLD_MIN_FACTOR=0.5
THRESHOLD_MAX_FACTOR=2.0

# ---------- AI（DeepSeek / OpenAI 兼容）----------
LLM_ENABLED=true
# 留空时自动降级到本地规则/模板/知识库；填 Key 后启用大模型。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SEC=3.0
LLM_MAX_RETRIES=1
LLM_CACHE_TTL_SEC=3600
LLM_MASK_INTERNAL_IP=true
LLM_WORKER_THREADS=1
LLM_QUEUE_SIZE=200

# ---------- 扫描 / CVE ----------
SCANNER_ENABLED=true
NMAP_PATH=nmap
SCAN_TIMEOUT_SEC=300
# 业务与服务同机：只扫本机，避免误扫外部网段。
SCAN_TARGETS=127.0.0.1
CVE_RULES_FILE=

# ---------- Web 攻击检测（关键：读取 Apache 8080 访问日志）----------
WEB_DETECT_ENABLED=true
WEB_DETECT_SOURCE=log
# 二选一，按实际 CustomLog 配置填：
#   /var/log/apache2/access.log            默认站点（combined 格式）
#   /var/log/apache2/other_vhosts_access.log  未单独配置 CustomLog 的 vhost（vhost_combined 格式，已支持）
WEB_LOG_PATH=/var/log/apache2/access.log
WEB_LOG_POLL_SEC=1
WEB_DEMO_INTERVAL_SEC=2.5
WEB_DETECT_BATCH=200
WEB_QUEUE_SIZE=2000
WEB_BRUTE_FORCE_ATTEMPTS=10
WEB_ATTACK_RULES_FILE=
# 日志里没有目的地址/端口：补成业务站点的真实地址（按需改为 192.168.x.x）。
WEB_DEFAULT_DST_IP=127.0.0.1
WEB_DEFAULT_DST_PORT=8080
# 传感器自访问、漏洞扫描器、宿主机管理机等来源（逗号分隔，支持 CIDR）。
# 与检测系统同机时，本机扫描/自访问来自回环，必须忽略，否则会污染统计与告警。
WEB_IGNORE_IPS=127.0.0.1,::1
# Web 告警自动封禁必须由直达规则确认（web_strict_rules.json 的高置信规则会标记直达）。
WEB_AUTO_BLOCK_REQUIRES_DIRECT=true

# ---------- 通用 Web 漏扫 ----------
# 高置信直达规则（与产品无关，路径/载荷双特征），生产环境同样建议开启。
WEB_STRICT_RULES_FILE=
# 漏扫时用于登录后深入检查的凭据（留空则只做未登录可见面扫描）。
WEBAPP_SCAN_USERNAME=
WEBAPP_SCAN_PASSWORD=
WEBAPP_SCAN_MAX_PAGES=24
WEBAPP_SCAN_MAX_SECONDS=20

# ---------- 攻击流量 → 漏洞研判 ----------
# 主动漏扫看不到注入点（没有版本特征），这一层用「攻击请求 + 响应是否回显」判定漏洞。
# 需要代理/日志能提供响应包才会判「已确认」，只有请求时记「疑似」。
WEB_VULN_INFER_ENABLED=true
WEB_VULN_INFER_AI=true
WEB_VULN_INFER_LIMIT=200

# 其余 v6 开关（AUTH_* / THREAT_* / RULESETS_* / PROTECTED_CIDRS）未列出时沿用
# backend/.env.example 的安全默认值：登录开启、威胁事件留存 7 天、规则档位 core。
