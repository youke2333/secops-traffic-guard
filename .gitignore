# ================= 运行环境与产物 =================
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 数据库与日志（本地运行时生成，不入库）
# 注意：只忽略仓库根目录的 data/；backend/data/ 是规则知识库，必须入库
/data/
*.db
*.db-wal
*.db-shm
*.log

# 环境变量（含密钥/Webhook Token，切勿提交）
.env
.env.local

# 工具与编辑器本地数据
.workbuddy/

# 编辑器
.idea/
.DS_Store

# 编辑器/IDE 本地配置
.vscode/
